[Unit]
Description=upstream private public-repository dispatch controller
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=nibfin
Group=nibfin
WorkingDirectory=/opt/nibfin/core
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStartPre=/usr/local/bin/node /opt/nibfin/core/bin/controller.mjs dispatch-service-check /etc/nibfin/public.json
ExecStart=/usr/local/bin/node /opt/nibfin/core/bin/controller.mjs dispatch-watch /etc/nibfin/public.json
Restart=on-success
RestartPreventExitStatus=2 SIGINT SIGTERM SIGHUP SIGPIPE
RestartSec=30
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
