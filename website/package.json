{
  "name": "@nibfin/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check",
    "lint": "eslint src --max-warnings 0",
    "blueprint": "blueprint inspect",
    "content": "node tooling/content.mjs",
    "test": "node --test test/*.test.mjs",
    "test:boundaries": "node tooling/boundaries.mjs",
    "build": "astro build",
    "links": "node tooling/links.mjs",
    "evidence": "node tooling/evidence.mjs",
    "check": "npm run typecheck && npm run lint && npm run blueprint && npm run content && npm test && npm run test:boundaries && npm run build && npm run links",
    "evidence:theme": "node tooling/theme-evidence.mjs",
    "candidate:clean": "node tooling/candidate-clean.mjs"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@astrojs/starlight": "0.37.6",
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@tailwindcss/vite": "4.1.18",
    "astro": "5.18.2",
    "flowbite-react": "0.12.17",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@kekkai/blueprint": "4.2.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "cheerio": "1.1.2",
    "eslint": "9.39.1",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
