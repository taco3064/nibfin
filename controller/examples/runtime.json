{
  "runnerId": "enrolled-private-runner",
  "stateDirectory": "/var/lib/nibfin/state",
  "publicKeyPath": "/etc/nibfin/owner-public.pem",
  "grantSource": {
    "repository": "OWNER/PRIVATE-CONTROL",
    "path": "grants/cohort.json",
    "ref": "main"
  },
  "allowedActors": [
    "OWNER"
  ],
  "proposalSource": {
    "repository": "OWNER/PRIVATE-CONTROL",
    "path": "authority/current-proposal.txt",
    "ref": "main"
  },
  "allowedWorkflowPaths": [
    ".github/workflows/nibfin.yml"
  ],
  "agent": {
    "image": "REGISTRY/TRUSTED-CODEX@sha256:REPLACE_WITH_64_HEX_DIGEST",
    "network": "nibfin-agent-private",
    "user": "1000:1000",
    "authDirectory": "/var/lib/nibfin/agent-auth",
    "timeoutMs": 1800000,
    "egressProxy": {
      "container": "nibfin-egress-proxy",
      "url": "http://172.30.91.2:3128",
      "scriptPath": "/opt/nibfin/security/egress-proxy.mjs"
    }
  }
}
