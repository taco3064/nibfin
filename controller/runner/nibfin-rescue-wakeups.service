[Unit]
Description=upstream pending Rescue notifications (no lifecycle execution)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nibfin
Group=nibfin
WorkingDirectory=/opt/nibfin/core
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/usr/local/bin/node /opt/nibfin/core/bin/controller.mjs serve-rescue-wakeups /etc/nibfin/actions-runtime.json
Restart=on-failure
RestartSec=30
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
